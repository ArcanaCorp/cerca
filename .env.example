# URL HTTPS de tu función de voz desplegada en Vercel.
# Nunca pongas OPENAI_API_KEY ni otro secreto en EXPO_PUBLIC_*.
EXPO_PUBLIC_CERCA_API_URL=https://tu-servicio.vercel.app

# Solo variables de entorno en Vercel (no en la aplicación):
# OPENAI_API_KEY=...
# OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# OPENAI_TEXT_MODEL=gpt-6-luna
